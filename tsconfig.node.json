{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ESNext",
    "resolveJsonModule": true,
    "noEmit": false,
    "outDir": "out"
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts",
    "server/**/*.ts",
    "prisma/**/*.ts"
  ]
}
